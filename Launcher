    def selecionar_jogo(self, jogo):
        if self.atualizando:
            messagebox.showwarning("Atualização em andamento", "Aguarde a atualização atual terminar antes de trocar de jogo.")
            return

        self.jogo_atual = jogo
        os.makedirs(jogo["pasta_local"], exist_ok=True)
        self.bg_label.destroy()
        self.configurar_fundo(jogo)
        self.mostrar_tela_principal()

    def clicou_forcar_atualizacao(self):
        if self.atualizando:
            messagebox.showwarning("Aviso", "Já existe uma checagem ou atualização em andamento.")
            return

        threading.Thread(
            target=self.verificar_e_atualizar_incremental,
            kwargs={"jogo": self.jogo_atual},
            daemon=True
        ).start()

    def gerenciar_estado_botao_update(self):
        if hasattr(self, "btn_forcar") and self.btn_forcar.winfo_exists():
            if self.atualizando:
                self.btn_forcar.configure(
                    state="disabled", text=f"ATUALIZANDO {self.jogo_atual['nome']}..."
                )
            else:
                self.btn_forcar.configure(
                    state="normal", text=f"ATUALIZAR {self.jogo_atual['nome']}"
                )

    def listar_arquivos_locais_obsoletos(self, arquivos_servidor_relativos, pasta_local):
        arquivos_ignorados_local = {
            os.path.normcase(os.path.normpath(JSON_FILE)),
            os.path.normcase(os.path.normpath(IMAGEM_FUNDO)),
            os.path.normcase(os.path.normpath(os.path.basename(sys.executable))),
            os.path.normcase(os.path.normpath("ftp_config.json")),
            os.path.normcase(os.path.normpath("pirataz.ico")),
            os.path.normcase(os.path.normpath("launcher_version.json")),
            os.path.normcase(os.path.normpath(os.path.basename(__file__)))
        }
        arquivos_obsoletos = []

        for raiz, _, arquivos in os.walk(pasta_local):
            for arquivo in arquivos:
                caminho_local = os.path.join(raiz, arquivo)
                caminho_relativo_local = os.path.normcase(os.path.normpath(os.path.relpath(caminho_local, pasta_local)))

                if caminho_relativo_local in arquivos_servidor_relativos:
                    continue
                if caminho_relativo_local in arquivos_ignorados_local:
                    continue

                arquivos_obsoletos.append((caminho_relativo_local, caminho_local))

        return arquivos_obsoletos

    def remover_arquivos_locais_obsoletos(self, arquivos_servidor_relativos, pasta_local):
        arquivos_locais_removidos = 0
        for _, caminho_local in self.listar_arquivos_locais_obsoletos(arquivos_servidor_relativos, pasta_local):
            try:
                os.remove(caminho_local)
                arquivos_locais_removidos += 1
            except Exception as err:
                print(f"Falha ao remover {caminho_local}: {err}")
                traceback.print_exc()

        # Também remove pastas vazias que sobraram após deletar arquivos obsoletos.
        for raiz, diretorios, arquivos in os.walk(pasta_local, topdown=False):
            for diretorio in diretorios:
                caminho_dir = os.path.join(raiz, diretorio)
                try:
                    if not os.listdir(caminho_dir):
                        os.rmdir(caminho_dir)
                except Exception as err:
                    print(f"Falha ao remover pasta {caminho_dir}: {err}")
                    traceback.print_exc()

        return arquivos_locais_removidos

    # --- ATUALIZADOR DIFERENCIAL + FORÇADO (RODANDO EM THREAD) ---
    def verificar_e_atualizar_incremental(self, forcar=False, baixar=True, jogo=None, somente_faltantes=False):
        if self.atualizando and not forcar:
            return

        jogo = jogo or self.jogo_atual
        pasta_servidor = jogo["servidor"]
        pasta_local = jogo["pasta_local"]
        os.makedirs(pasta_local, exist_ok=True)
        self.atualizando = True
        if hasattr(self, "btn_iniciar") and self.btn_iniciar.winfo_exists():
            self.btn_iniciar.configure(state="disabled")
        self.gerenciar_estado_botao_update()

        try:
            arquivos_servidor_relativos = set()
            mudancas = []
            operacoes_locais = []
            arquivos_obsoletos = []
            # Suporte a PASTA_SERVIDOR local ou via FTP (ftp://...)
            if pasta_servidor.startswith("ftp://"):
                if forcar:
                    self.atualizar_status("Forçando verificação completa de arquivos...")
                else:
                    self.atualizar_status("Verificando arquivos modificados...")

                user, pwd = carregar_ftp_credenciais()

                def _progress(processed, total, relpath):
                    try:
                        self.atualizar_status(f"Checando: {relpath}")
                        if total:
                            self.atualizar_progresso(processed / total)
                    except Exception:
                        pass

                resultado = ftp_client.download_tree(
                    pasta_servidor,
                    pasta_local,
                    username=user,
                    password=pwd,
                    forcar=forcar,
                    somente_faltantes=False,
                    progress_callback=_progress,
                    baixar=False,
                )
                total_arquivos = resultado.get("total", 0)
                mudancas = resultado.get("changes", [])
                arquivos_servidor_relativos = resultado.get("server_files", set())

            else:
                if not os.path.exists(pasta_servidor):
                    self.atualizar_status("[Servidor Offline] Iniciando em modo Local.")
                    self.atualizar_progresso(1.0)
                    return

                if forcar:
                    self.atualizar_status("Forçando verificação completa de arquivos...")
                else:
                    self.atualizar_status("Verificando arquivos modificados...")
                
                lista_arquivos_servidor = []
                arquivos_servidor_relativos = set()
                for raiz, _, arquivos in os.walk(pasta_servidor):
                    for arquivo in arquivos:
                        caminho_servidor = os.path.join(raiz, arquivo)
                        caminho_relativo_servidor = os.path.normcase(os.path.normpath(os.path.relpath(caminho_servidor, pasta_servidor)))
                        lista_arquivos_servidor.append(caminho_servidor)
                        arquivos_servidor_relativos.add(caminho_relativo_servidor)
                
                total_arquivos = len(lista_arquivos_servidor)

                for caminho_servidor in lista_arquivos_servidor:
                    caminho_relativo = os.path.relpath(caminho_servidor, pasta_servidor)
                    caminho_local = os.path.join(pasta_local, caminho_relativo)

                    self.atualizar_status(f"Checando: {caminho_relativo}")

                    arquivo_faltante = not os.path.exists(caminho_local)
                    servidor_mtime = os.path.getmtime(caminho_servidor)
                    servidor_tamanho = os.path.getsize(caminho_servidor)
                    deve_baixar = arquivo_faltante or (
                        os.path.getmtime(caminho_local) != servidor_mtime
                        or os.path.getsize(caminho_local) != servidor_tamanho
                    ) if not arquivo_faltante else True
                    if deve_baixar:
                        mudanca = {
                            "action": "add" if arquivo_faltante else "update",
                            "path": caminho_relativo,
                            "size": servidor_tamanho,
                            "mtime": servidor_mtime,
                        }
                        mudancas.append(mudanca)
                        operacoes_locais.append((caminho_servidor, caminho_local, mudanca))

                    if total_arquivos:
                        self.atualizar_progresso(
                            (lista_arquivos_servidor.index(caminho_servidor) + 1) / total_arquivos
                        )

            arquivos_obsoletos = self.listar_arquivos_locais_obsoletos(
                arquivos_servidor_relativos, pasta_local
            )
            arquivos_atualizados = 0
            arquivos_locais_removidos = 0

            if not mudancas and not arquivos_obsoletos:
                self.atualizar_status("Jogo está na versão mais recente.")
                self.atualizar_progresso(1.0)
                if forcar:
                    messagebox.showinfo("Informação", "Sua instalação já está 100% idêntica ao servidor de arquivos.")
                return

            if not baixar:
                self.atualizar_status("Atualização cancelada.")
                return

            if pasta_servidor.startswith("ftp://"):
                resultado_aplicacao = ftp_client.download_tree(
                    pasta_servidor,
                    pasta_local,
                    username=user,
                    password=pwd,
                    forcar=forcar,
                    progress_callback=_progress,
                    baixar=True,
                )
                arquivos_atualizados = resultado_aplicacao.get("updated", 0)
            else:
                for caminho_servidor, caminho_local, mudanca in operacoes_locais:
                    self.atualizar_status(f"Atualizando: {mudanca['path']}")
                    os.makedirs(os.path.dirname(caminho_local), exist_ok=True)
                    shutil.copy2(caminho_servidor, caminho_local)
                    arquivos_atualizados += 1
                    time.sleep(0.04)

            arquivos_locais_removidos = self.remover_arquivos_locais_obsoletos(
                arquivos_servidor_relativos, pasta_local
            )

            # --- VERIFICAÇÃO E ATUALIZAÇÃO DE VERSÃO ---
            versao_nova = None
            changelog = ""
            
            if pasta_servidor.startswith("ftp://"):
                # Tentar obter versão do servidor via FTP
                try:
                    versao_nova = ftp_client.obter_versao_remota(pasta_servidor, VERSAO_SERVIDOR_FILE, username=user, password=pwd)
                except Exception:
                    versao_nova = None
            else:
                # Tentar obter versão do servidor local
                caminho_versao_servidor = os.path.join(pasta_servidor, VERSAO_SERVIDOR_FILE)
                if os.path.exists(caminho_versao_servidor):
                    try:
                        with open(caminho_versao_servidor, "r", encoding="utf-8") as f:
                            dados = json.load(f)
                            versao_nova = dados.get("version")
                            changelog = dados.get("changelog", "")
                    except Exception:
                        versao_nova = None

            versao_local = obter_versao_local(pasta_local)
            requer_restart = False

            if versao_nova and versao_nova != versao_local:
                # Nova versão detectada
                salvar_versao_local(versao_nova, pasta_local)
                requer_restart = True
                if changelog:
                    mensagem_changelog = f"\n\n📋 Changelog:\n{changelog}"
                else:
                    mensagem_changelog = ""

            if arquivos_atualizados > 0 or arquivos_locais_removidos > 0:
                mensagem = []
                if arquivos_atualizados > 0:
                    mensagem.append(f"{arquivos_atualizados} arquivo(s) sincronizado(s)")
                if arquivos_locais_removidos > 0:
                    mensagem.append(f"{arquivos_locais_removidos} arquivo(s) locais removido(s)")
                self.atualizar_status(" / ".join(mensagem) + ".")
                
                if requer_restart:
                    mensagem_box = f"✅ Atualização instalada com sucesso!\n\nVersão anterior: {versao_local}\nVersão nova: {versao_nova}\n" + "\n".join(mensagem) + mensagem_changelog + "\n\nO aplicativo será reiniciado em 5 segundos..."
                    messagebox.showinfo("Atualização Concluída", mensagem_box)
                    # Aguarda 5 segundos e reinicia
                    threading.Timer(5.0, reiniciar_aplicativo).start()
                elif forcar:
                    messagebox.showinfo("Sucesso", f"Atualização forçada concluída!\n" + "\n".join(mensagem))
            else:
                self.atualizar_status("Jogo está na versão mais recente.")
                if forcar:
                    messagebox.showinfo("Informação", "Sua instalação já está 100% idêntica ao servidor de arquivos.")

        except Exception as e:
            self.atualizar_status(f"Erro FTP: {str(e)[:100]}")
            print(f"Erro na sincronização: {e}")
            traceback.print_exc()
        finally:
            if hasattr(self, "btn_iniciar") and self.btn_iniciar.winfo_exists():
                self.btn_iniciar.configure(state="normal")
            self.atualizando = False
            self.gerenciar_estado_botao_update()


