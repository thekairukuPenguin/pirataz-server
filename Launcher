def carregar_pasta_raiz_jogos():
    try:
        if os.path.exists(JSON_FILE):
            with open(JSON_FILE, "r", encoding="utf-8") as f:
                pasta_configurada = json.load(f).get("pasta_jogos")
                if pasta_configurada:
                    return os.path.abspath(os.path.expandvars(pasta_configurada))
    except (OSError, json.JSONDecodeError):
        pass
    return PASTA_RAIZ_JOGOS_PADRAO


def pasta_raiz_jogos_configurada():
    if not os.path.exists(JSON_FILE):
        return False
    try:
        with open(JSON_FILE, "r", encoding="utf-8") as f:
            return bool(json.load(f).get("pasta_jogos"))
    except (OSError, json.JSONDecodeError):
        return False


