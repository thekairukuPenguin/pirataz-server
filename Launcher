# --- GERENCIAMENTO DE USUÁRIO (JSON) ---
def obter_usuario():
    if os.path.exists(JSON_FILE):
        with open(JSON_FILE, "r", encoding="utf-8") as f:
            dados = json.load(f)
            return dados.get("username")
    return None

def salvar_usuario(username):
    dados = {}
    if os.path.exists(JSON_FILE):
        try:
            with open(JSON_FILE, "r", encoding="utf-8") as f:
                dados = json.load(f)
        except (OSError, json.JSONDecodeError):
            dados = {}
    dados["username"] = username.strip()
    with open(JSON_FILE, "w", encoding="utf-8") as f:
        json.dump(dados, f, indent=4)


def salvar_pasta_raiz_jogos(pasta):
    dados = {}
    if os.path.exists(JSON_FILE):
        try:
            with open(JSON_FILE, "r", encoding="utf-8") as f:
                dados = json.load(f)
        except (OSError, json.JSONDecodeError):
            dados = {}
    dados["pasta_jogos"] = pasta
    with open(JSON_FILE, "w", encoding="utf-8") as f:
        json.dump(dados, f, indent=4)


def carregar_ftp_credenciais():
    for cfg in (os.path.join(BASE_PATH, "ftp_config.json"), os.path.join(RESOURCE_PATH, "ftp_config.json")):
        if os.path.exists(cfg):
            try:
                with open(cfg, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    return data.get("username"), data.get("password")
            except Exception:
                continue
    return None, None


# --- GERENCIAMENTO DE VERSÃO ---
def obter_versao_local(pasta_local=PASTA_LOCAL):
    """Obtém a versão local do launcher"""
    caminho_versao = os.path.join(pasta_local, VERSAO_LOCAL_FILE)
    if os.path.exists(caminho_versao):
        try:
            with open(caminho_versao, "r", encoding="utf-8") as f:
                dados = json.load(f)
                return dados.get("version", "0.0.0")
        except Exception:
            return "0.0.0"
    return "0.0.0"


def salvar_versao_local(versao, pasta_local=PASTA_LOCAL):
    """Salva a versão local do launcher"""
    try:
        os.makedirs(pasta_local, exist_ok=True)
        with open(os.path.join(pasta_local, VERSAO_LOCAL_FILE), "w", encoding="utf-8") as f:
            json.dump({"version": versao}, f, indent=4)
    except Exception as e:
        print(f"Erro ao salvar versão local: {e}")


def reiniciar_aplicativo():
    """Reinicia o aplicativo (apenas funciona com executável)"""
    try:
        # Se for um executável PyInstaller
        if getattr(sys, 'frozen', False):
            os.execl(sys.executable, sys.executable, *sys.argv)
        else:
            # Se for script Python normal
            python = sys.executable
            os.execl(python, python, *sys.argv)
    except Exception as e:
        print(f"Erro ao reiniciar: {e}")
        messagebox.showerror("Erro", f"Não foi possível reiniciar o app: {e}")

# --- EXECUÇÃO DOS JOGOS ---
def executar_jogo(jogo, mapa=None):
    username = obter_usuario()
    if not username:
        messagebox.showwarning("Aviso", "Usuário não encontrado. Faça login novamente.")
        return

    try:
        if jogo["id"].lower() == "palword":
            executavel = os.path.join(jogo["pasta_local"], jogo["executavel"])
            if not os.path.isfile(executavel):
                executaveis = [
                    nome for nome in os.listdir(jogo["pasta_local"])
                    if nome.lower().endswith(".exe")
                ]
                if len(executaveis) == 1:
                    executavel = os.path.join(jogo["pasta_local"], executaveis[0])
                else:
                    raise FileNotFoundError(
                        f"Não encontrei {jogo['executavel']} na pasta do Palworld."
                    )

            subprocess.Popen([executavel], cwd=jogo["pasta_local"])
            return

        configuracao_mapa = MAPAS_DAYZ[mapa or "Livonia"]
        comando = [
            os.path.join(jogo["pasta_local"], "x_64.exe"),
            f"-mod={';'.join(os.path.join('mods', mod) for mod in configuracao_mapa['mods'].split(';'))}",
            f"-connect={configuracao_mapa['endereco']}",
            f"-port={configuracao_mapa['porta']}",
            f"-name={username}"
        ]
        subprocess.Popen(comando, cwd=jogo["pasta_local"])
    except Exception as e:
        messagebox.showerror("Erro ao iniciar", f"Não foi possível iniciar {jogo['nome']}: {e}")


# --- INTERFACE GRÁFICA PRINCIPAL ---
class PirataZLauncher(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.title("Launcher")
        self.geometry("1200x648")
        self.resizable(False, False)

        self.janela_maximizada = False
        
        # Variável de segurança para controle de Threads de atualização
        self.atualizando = False
        self.jogo_atual = JOGOS[0]
        self.jogo_pendente = None
        self.mapa_pendente = None
        self.frame_abas = None
        os.makedirs(PASTA_RAIZ_JOGOS, exist_ok=True)

        # Janela padrão do Windows com ícone
        self.configurar_fundo()
        self.configurar_icone_e_titulo()
        self.configurar_caixa_progresso()

        # 5. Controle de Fluxo de Telas
        self.usuario_atual = obter_usuario()
        if not pasta_raiz_jogos_configurada():
            self.configurar_pasta_jogos(mostrar_instrucao=True)
        self.mostrar_tela_principal()

    def configurar_fundo(self, jogo=None):
        jogo = jogo or self.jogo_atual
        imagem_caminho = os.path.join(RESOURCE_PATH, jogo.get("background", IMAGEM_FUNDO))

        if os.path.exists(imagem_caminho):
            img_pil = Image.open(imagem_caminho)
            self.bg_image = ctk.CTkImage(light_image=img_pil, dark_image=img_pil, size=(1200, 648))
            self.bg_label = ctk.CTkLabel(self, image=self.bg_image, text="", width=1200, height=648)
            self.bg_label.place(x=0, y=0)
        else:
            self.bg_label = ctk.CTkLabel(self, text="[Insira a imagem 'background.png' para ativar o visual]", 
                                         fg_color="#111111", text_color="#ffffff", font=("Arial", 14),
                                         width=1200, height=648)
            self.bg_label.place(x=0, y=0)

        if hasattr(self, "frame_progresso") and self.frame_progresso.winfo_exists():
            self.frame_progresso.lift()

    def configurar_icone_e_titulo(self):
        icone_caminhos = [
            os.path.join(RESOURCE_PATH, "assets", "pirataz.ico"),
            os.path.join(RESOURCE_PATH, "pirataz.ico"),
        ]
        icone_caminho = next((caminho for caminho in icone_caminhos if os.path.exists(caminho)), None)
        if icone_caminho:
            try:
                self.icone_janela = ImageTk.PhotoImage(Image.open(icone_caminho))
                self.iconphoto(True, self.icone_janela)
                self.iconbitmap(icone_caminho)
                self.wm_iconbitmap(icone_caminho)
            except Exception:
                print(f"Não foi possível carregar o ícone: {icone_caminho}")

    def atualizar_status(self, texto):
        if hasattr(self, "lbl_status_arquivos") and self.lbl_status_arquivos.winfo_exists():
            self.lbl_status_arquivos.configure(text=texto)

    def atualizar_progresso(self, valor):
        if hasattr(self, "barra_progresso") and self.barra_progresso.winfo_exists():
            self.barra_progresso.set(valor)

    def configurar_caixa_progresso(self):
        self.frame_progresso = ctk.CTkFrame(
            self, width=630, height=84, fg_color="#0D0D0D",
            border_width=1, border_color="#FFFFFF", corner_radius=0
        )
        self.frame_progresso.place(x=1010, y=630, anchor="se")
        self.frame_progresso.pack_propagate(False)

        self.lbl_status_arquivos = ctk.CTkLabel(
            self.frame_progresso, text="Clique para atualizar...",
            font=("Lucida Console", 9), text_color="#D0D0D0", anchor="w"
        )
