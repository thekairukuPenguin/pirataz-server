        )
        self.barra_progresso.set(0)
        self.barra_progresso.pack(side="top", padx=10, pady=(1, 6))

    def limpar_widgets_dinamicos(self):
        for widget in self.winfo_children():
            if widget not in [self.bg_label, self.frame_abas, self.frame_progresso]:
                widget.destroy()

    def mostrar_tooltip_pasta(self, widget):
        self.esconder_tooltip_pasta()
        self.tooltip_pasta = ctk.CTkLabel(
            self,
            text="Pasta do jogo",
            fg_color="#151515",
            text_color=COR_BRANCA,
            corner_radius=4,
            font=("Arial", 11),
        )
        self.posicionar_tooltip(self.tooltip_pasta, widget)

    def esconder_tooltip_pasta(self):
        if hasattr(self, "tooltip_pasta") and self.tooltip_pasta.winfo_exists():
            self.tooltip_pasta.destroy()

    def mostrar_tooltip_usuario(self, widget):
        self.esconder_tooltip_pasta()
        nome_usuario = obter_usuario() or "Não cadastrado"
        self.tooltip_pasta = ctk.CTkLabel(
            self,
            text=f"Usuário: {nome_usuario}",
            fg_color="#151515",
            text_color=COR_BRANCA,
            corner_radius=4,
            font=("Arial", 11),
        )
        self.posicionar_tooltip(self.tooltip_pasta, widget)

    def posicionar_tooltip(self, tooltip, widget):
        self.update_idletasks()
        tooltip.update_idletasks()
        x = (
            widget.winfo_rootx()
            + widget.winfo_width()
            - tooltip.winfo_reqwidth()
            - self.winfo_rootx()
        )
        y = widget.winfo_rooty() + widget.winfo_height() + 4 - self.winfo_rooty()
        tooltip.place(x=max(0, x), y=y)

    def mostrar_tela_login(self):
        if self.frame_abas is not None and self.frame_abas.winfo_exists():
            self.frame_abas.destroy()
            self.frame_abas = None
        self.limpar_widgets_dinamicos()

        frame_login = ctk.CTkFrame(self, width=320, height=200, corner_radius=8, fg_color="#151515", border_width=1, border_color=COR_ROXA)
        frame_login.place(relx=0.5, rely=0.5, anchor="center")
        frame_login.pack_propagate(False)

        lbl_tit = ctk.CTkLabel(frame_login, text="Insira um nome de Sobrevivente.", font=("Arial", 16), text_color=COR_BRANCA)
        lbl_tit.pack(pady=(25, 10))

        self.ent_usuario = ctk.CTkEntry(frame_login, width=240, placeholder_text="Nome_de_Usuario (use _ - .)", justify="center")
        self.ent_usuario.pack(pady=10)
        self.ent_usuario.focus()

        btn_entrar = ctk.CTkButton(frame_login, text="CONECTAR", fg_color=COR_ROXA, hover_color=COR_ROXA_HOVER,
                                   text_color=COR_BRANCA, font=("Arial Black", 11), width=240, height=35, command=self.processar_login)
        btn_entrar.pack(pady=10)

    def processar_login(self):
        nome = self.ent_usuario.get().strip()
        if not nome:
            messagebox.showwarning("Aviso", "Insira um nome de usuário válido.")
            return

        # Allow only letters, numbers, underscore, hyphen and dot — no spaces
        if not re.match(r'^[A-Za-z0-9_.-]+$', nome):
            messagebox.showwarning("Aviso", "Nome inválido. Use apenas letras, números, '_' ou '-' e '.'. Sem espaços.")
            return

        salvar_usuario(nome)
        self.usuario_atual = nome
        jogo_pendente = self.jogo_pendente
        mapa_pendente = self.mapa_pendente
        self.jogo_pendente = None
        self.mapa_pendente = None
        self.mostrar_tela_principal()
        if jogo_pendente:
            executar_jogo(jogo_pendente, mapa_pendente)

    def configurar_pasta_jogos(self, mostrar_instrucao=False):
        global PASTA_RAIZ_JOGOS

        if mostrar_instrucao:
            messagebox.showinfo(
                "Primeiro passo",
                "Escolha o disco para instalação dos jogos.\n\n"
                "Clique em OK e, na próxima janela, escolha o disco "
                "onde os jogos serão instalados.",
                parent=self,
            )

        pasta = filedialog.askdirectory(
            parent=self,
            title="Escolha a pasta onde os jogos serão instalados",
            initialdir=PASTA_RAIZ_JOGOS if os.path.isdir(PASTA_RAIZ_JOGOS) else os.path.expanduser("~"),
        )
        if not pasta:
            return

        pasta = os.path.join(os.path.abspath(pasta), "pirataz")

        confirmar = messagebox.askyesno(
            "Alterar pasta dos jogos",
            f"Os jogos serão instalados em:\n\n{pasta}\n\nDeseja continuar?",
            parent=self,
        )
        if not confirmar:
            return

        PASTA_RAIZ_JOGOS = pasta
        os.makedirs(PASTA_RAIZ_JOGOS, exist_ok=True)
        salvar_pasta_raiz_jogos(pasta)
        for jogo in JOGOS:
            nome_pasta = "DayZ" if jogo["id"] == "dayz" else "Palword"
            jogo["pasta_local"] = os.path.join(PASTA_RAIZ_JOGOS, nome_pasta)
            os.makedirs(jogo["pasta_local"], exist_ok=True)

        messagebox.showinfo(
            "Pasta configurada",
            "A nova pasta foi salva. Os jogos serão instalados e iniciados nesse local.",
            parent=self,
        )
        self.mostrar_tela_principal()
        return True

    def iniciar_jogo(self, mapa=None):
        if not obter_usuario():
            self.jogo_pendente = self.jogo_atual
            self.mapa_pendente = mapa
            self.mostrar_tela_login()
            return
        executar_jogo(self.jogo_atual, mapa)

